# No secrets in git. Variables are added per phase (Stripe in Phase 7).
NEXT_PUBLIC_ROOT_DOMAIN=saitify.ro
NEXT_PUBLIC_SITE_URL=https://saitify.ro

# Contact form delivery (Resend). Leave empty to keep the form honestly disabled.
CONTACT_RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# --- Phase 4: accounts & projects ---------------------------------------------
# Public origin of the app (https in production). Used for cookies, email links and the CSRF origin check.
APP_URL=https://saitify.ro
# PostgreSQL connection string (Supabase: use the pooled/transaction URL). Run migrations once:
#   pnpm --filter @saitify/platform db:migrate
DATABASE_URL=
# Transactional email via Resend. Without these, sign-up still works but email actions say "unavailable".
RESEND_API_KEY=
EMAIL_FROM=
# Header carrying the real client IP for rate limiting (Netlify default shown).
RATE_LIMIT_IP_HEADER=x-nf-client-connection-ip
# Local development only (never on Netlify): embedded Postgres + file outbox instead of real services.
# SAITIFY_DB=pglite
# PGLITE_DIR=.data/db
# EMAIL_TRANSPORT=outbox
# EMAIL_OUTBOX_FILE=.data/outbox.jsonl
